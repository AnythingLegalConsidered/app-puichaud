---
const pathname = Astro.url.pathname;
const isCurrent = (path: string) => path === '/' ? pathname === '/' : pathname.startsWith(path);
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">Ianis Puichaud</a>
    <nav aria-label="Navigation principale">
      <a href="/projets/" aria-current={isCurrent('/projets') ? 'page' : undefined}>Projets</a>
      <a href="/cv/" aria-current={isCurrent('/cv') ? 'page' : undefined}>CV</a>
      <a href="mailto:pro@puichaud.com">Contact</a>
    </nav>
  </div>
</header>
