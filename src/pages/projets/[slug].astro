---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { projects } from '../../data/projects.js';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const description = `${project.summary} ${project.outcome}`;
const gallery = project.gallery ?? [];
const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.name,
  creator: { '@type': 'Person', name: 'Ianis Puichaud', url: 'https://puichaud.com' },
  description,
  url: `https://puichaud.com/projets/${project.slug}/`,
  keywords: project.tags.join(', '),
};
---

<Base
  title={`${project.name} — étude de cas · Ianis Puichaud`}
  description={description}
  canonicalPath={`/projets/${project.slug}/`}
  image={project.image}
  schema={projectSchema}
>
  <a class="skip-link" href="#main">Aller au contenu</a>
  <Header />
  <main id="main" class="wrap">
    <header class="case-header">
      <a class="back-link" href="/projets/">← Tous les projets</a>
      <div class="case-kicker">{project.number} · {project.meta} · {project.status}</div>
      <h1 class="page-title">{project.name}</h1>
      <p class="case-lede">{project.summary}</p>
      <dl class="case-facts">
        {project.facts.map((fact) => (
          <div class="fact"><dt>{fact.value}</dt><dd>{fact.label}</dd></div>
        ))}
      </dl>
      <div class="tags">{project.tags.join(' · ')}</div>
    </header>

    {project.image && (
      <figure class="case-cover">
        <img src={project.image} alt={project.imageAlt} width="1280" height="577" decoding="async" />
        <figcaption>Capture du projet. Les informations sensibles ne sont pas publiées.</figcaption>
      </figure>
    )}

    <article class="case-content">
      <section>
        <h2>Le problème à résoudre</h2>
        <p>{project.challenge}</p>
        <blockquote>{project.outcome}</blockquote>
      </section>

      <section>
        <h2>Ce que j’ai fait</h2>
        <ul>{project.work.map((item) => <li>{item}</li>)}</ul>
      </section>

      <section>
        <h2>Résultats</h2>
        <ul>{project.results.map((item) => <li>{item}</li>)}</ul>
      </section>

      {gallery.length > 0 && (
        <div class="case-gallery">
          {gallery.map((image) => (
            <figure>
              <img src={image.src} alt={image.alt} width="1280" height="577" loading="lazy" decoding="async" />
              <figcaption>{image.alt}</figcaption>
            </figure>
          ))}
        </div>
      )}

      <section class="limits">
        <h2>Limites</h2>
        <ul>{project.limits.map((item) => <li>{item}</li>)}</ul>
      </section>

      <div class="case-end">
        {project.external && (
          <p><a href={project.external.href} target="_blank" rel="noopener">{project.external.label} ↗</a></p>
        )}
        <p>Je peux détailler les choix, les incidents et les compromis en entretien. <a href="mailto:pro@puichaud.com">Me contacter</a>.</p>
      </div>
    </article>
  </main>
  <Footer />
</Base>
